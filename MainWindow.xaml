<Window x:Class="LiangWenWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="梁文挂件"
        Width="440" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        Foreground="White"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        AllowDrop="True"
        Drop="OnFileDrop"
        DragOver="OnDragOver">

    <Window.ContextMenu>
        <ContextMenu Background="#111" Foreground="White">
            <MenuItem Header="重新设置 API Key" Click="OnReconfigure"/>
            <MenuItem Header="切换模型 (flash/pro)" Click="OnToggleModel"/>
            <MenuItem Header="清除背景图" Click="OnClearBackground"/>
            <Separator/>
            <MenuItem Header="关闭" Click="OnClose"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- brightness-based dim overlay (sits behind modules, above window background) -->
        <Rectangle x:Name="DimOverlay" Grid.RowSpan="4" Fill="Black" Opacity="0"
                   IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- 1. countdown -->
        <Border x:Name="M1" Grid.Row="0" BorderThickness="2" Background="#00000000" Padding="8" Margin="0,0,0,8">
            <TextBlock FontSize="18" HorizontalAlignment="Center">
                <Run Text="峰" Foreground="#F48FB1"/><Run Text="/" Foreground="White"/><Run Text="谷" Foreground="#81D4FA"/><Run Text=" 倒计时 " Foreground="White"/><Run x:Name="CountdownValue" Text="--:--" Foreground="White"/>
            </TextBlock>
        </Border>

        <!-- 2. avatar + status chars -->
        <Border x:Name="M2" Grid.Row="1" BorderThickness="2" Background="#00000000" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#81D4FA" BorderThickness="2" Width="120" Height="120"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Image x:Name="AvatarImage" Stretch="UniformToFill"/>
                </Border>

                <UniformGrid Grid.Row="1" Rows="1" Columns="3" VerticalAlignment="Center">
                    <TextBlock Text="梁" FontSize="96" Foreground="#9E9E9E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="文" FontSize="96" Foreground="#9E9E9E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusChar" Text="锋" FontSize="96" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- 3. description -->
        <Border x:Name="M3" Grid.Row="2" BorderThickness="2" Background="#00000000" Padding="10" Margin="0,8,0,8">
            <TextBlock x:Name="DescriptionText" Text="等待首次查询…" FontSize="16" Foreground="#BDBDBD"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- 4. bottom row -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="M4" Grid.Column="0" BorderThickness="2" Background="#00000000" Padding="10">
                <TextBlock FontSize="16" VerticalAlignment="Center">
                    <Hyperlink x:Name="RechargeLink" NavigateUri="https://platform.deepseek.com"
                               Foreground="#F48FB1" RequestNavigate="OnNavigate">API 充值</Hyperlink>
                </TextBlock>
            </Border>

            <Border x:Name="M5" Grid.Column="2" BorderThickness="2" Background="#00000000" Padding="10"
                    MouseLeftButtonUp="OnToggleModel" Cursor="Hand">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="BalanceText" Text="余量/token --" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ModelLabel" Text="flash" FontSize="12" Foreground="#80CBC4"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
